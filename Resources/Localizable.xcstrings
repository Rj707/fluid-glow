    "Drag across the canvas to draw silky glowing streams that flow with realistic liquid physics." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe über die Leinwand, um seidige Leuchtströme mit realistischer Flüssigkeitsphysik zu erzeugen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag across the canvas to draw silky glowing streams that flow with realistic liquid physics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra por el lienzo para dibujar corrientes brillantes que fluyen con física líquida realista."
