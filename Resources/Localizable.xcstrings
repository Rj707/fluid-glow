    "Put on headphones! Ambient harmonic chimes and frequencies react to your finger speed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopfhörer aufsetzen! Harmonische Klänge und Frequenzen reagieren auf deine Fingergeschwindigkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put on headphones! Ambient harmonic chimes and frequencies react to your finger speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ponte auriculares! Los tonos armónicos y frecuencias ambientales reaccionan a la velocidad de tus dedos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez des écouteurs! Les carillons harmoniques et fréquences réagissent à la vitesse de vos doigts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘッドホンを装着してください！指の動く速度に合わせて美しい和音と周波数がリアルタイムに響きます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque fones de ouvido! Os sinos harmônicos e frequências ambientes reagem à velocidade dos seus dedos."
